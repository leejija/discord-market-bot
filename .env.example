# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_TOKEN=your_bot_token_here

# 시세를 게시할 채널 ID (Discord에서 개발자 모드 켜고 채널 우클릭 → ID 복사)
CHANNEL_ID=123456789012345678

# 시세 자동 게시 시간 (한국시간 기준, HH:MM)
# 쉼표로 여러 번 지정 가능 — 기본값: 07:00(미국장 마감 후), 16:00(한국장 마감 후)
POST_TIME=07:00,16:00

# 슬래시 명령어용 서버(길드) ID — 설정하면 명령어가 즉시 반영됨
GUILD_ID=

# Anthropic API 키 (이슈 요약 메시지의 「종합 요약」 생성용)
# 없으면 종합 요약은 표시되지 않음 (뉴스 링크는 정상 표시)
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=
