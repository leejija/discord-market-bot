# Discord Developer Portal에서 발급받은 봇 토큰
DISCORD_TOKEN=your_bot_token_here

# 시세를 게시할 채널 ID (Discord에서 개발자 모드 켜고 채널 우클릭 → ID 복사)
CHANNEL_ID=123456789012345678

# 자동 게시 시간 (한국시간 기준, HH:MM 형식)
# 기본값: 07:00 (미국장 마감 후 일일 요약)
POST_TIME=07:00

# 한국 증시 이슈 요약 시간 (KST, HH:MM)
# 기본값: 20:00 (코스피 NXT 마감 직후)
KR_SUMMARY_TIME=20:00

# 미국 증시 이슈 요약 시간 (KST, HH:MM)
# 기본값: 06:00 (미국 정규장 16:00 ET 마감 직후)
US_SUMMARY_TIME=06:00
